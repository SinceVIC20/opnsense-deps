diff --git a/security/nss/files/patch-coreconf_FreeBSD.mk b/security/nss/files/patch-coreconf_FreeBSD.mk
index 686309506..58d01702a 100644
--- a/security/nss/files/patch-coreconf_FreeBSD.mk
+++ b/security/nss/files/patch-coreconf_FreeBSD.mk
@@ -41,10 +41,23 @@ index fcbf23f6a..280d3a140 100644
  ifdef MAPFILE
  	MKSHLIB += -Wl,--version-script,$(MAPFILE)
  endif
-@@ -55,4 +65,5 @@ PROCESS_MAP_FILE = grep -v ';-' $< | \
+@@ -55,4 +65,18 @@ PROCESS_MAP_FILE = grep -v ';-' $< | \
  
  G++INCLUDES		= -I/usr/include/g++
  
 -INCLUDES		+= -I/usr/X11R6/include
 +USE_SYSTEM_ZLIB		= 1
 +ZLIB_LIBS		= -lz
++
++# Test toolchain for endianness and set LITTLE_ENDIAN accordingly. Upstream
++# only does this in Linux.mk; without it, aarch64 builds silently skip
++# -DHAVE_PLATFORM_GHASH in lib/freebl/Makefile while still adding
++# ghash-aarch64.c to EXTRA_SRCS, causing a duplicate-symbol link error
++# (platform_ghash_support, gcm_Hash*_hw) against gcm.c's stub definitions
++# of the same platform-ghash functions.
++ENDIANNESS := $(shell echo | $(CC) -dM -E - | grep __BYTE_ORDER__)
++ifeq ($(findstring __ORDER_LITTLE_ENDIAN__,$(ENDIANNESS)),__ORDER_LITTLE_ENDIAN__)
++    LITTLE_ENDIAN := 1
++else
++    LITTLE_ENDIAN := 0
++endif
