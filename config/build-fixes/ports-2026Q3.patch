+	${REINPLACE_CMD} -e 's|@APXS@|@APXS@ -DENODATA=EIO|g' \
+	    -e 's|@APXS@|@APXS@ ${LDFLAGS:N-fstack-protector-strong} -linotify|g' \
+	    ${WRKSRC}/Makefile.in
+
