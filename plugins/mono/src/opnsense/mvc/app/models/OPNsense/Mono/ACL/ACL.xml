<acl>
    <page-mono-status>
        <name>Dashboard: Mono Gateway</name>
        <patterns>
            <pattern>api/mono/status/*</pattern>
        </patterns>
    </page-mono-status>
    <page-mono-sfp>
        <name>System: Diagnostics: SFP+</name>
        <patterns>
            <pattern>ui/mono/sfp*</pattern>
            <pattern>api/mono/sfp/*</pattern>
        </patterns>
    </page-mono-sfp>
    <page-mono-fan>
        <name>System: Settings: Fan control</name>
        <patterns>
            <pattern>ui/mono/fan*</pattern>
            <pattern>api/mono/fan/*</pattern>
            <pattern>api/hwmon/sensors/*</pattern>
        </patterns>
    </page-mono-fan>
</acl>
