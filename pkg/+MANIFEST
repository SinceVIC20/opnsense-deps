name: "mono-gateway"
version: "%%VERSION%%"
origin: "sysutils/mono-gateway"
annotations: { source_commit: "%%COMMIT%%" }
deps: { mono-upgrade-safety: { origin: "sysutils/mono-upgrade-safety", version: "%%SAFETY_DEP_VERSION%%" } }
comment: "Mono Gateway board support package (NXP LS1046A)"
desc: <<EOD
Board-specific kernel modules, userspace tools, configuration files,
and boot scripts for the Mono Gateway Development Kit.

Includes DPAA1 CDX flow offload (cdx, fci, auto_bridge, pf_notify),
hardware drivers (emc2302, ina2xx, lp5812, sfpled), FMan configuration
tools (fmc, dpa_app), connection management (cmm, cmmctl), and fan
control (fand).
EOD
maintainer: "tomaz@mono.si"
www: "https://mono.si"
arch: "FreeBSD:14:aarch64"
prefix: "/"
categories: ["sysutils"]
licenses: ["BSD2CLAUSE"]
licenselogic: "single"
scripts: {
  post-install: <<EOD
/usr/local/etc/rc.syshook.d/start/50-mono-motd %%VERSION%% || true
/usr/local/sbin/mono-core-patches apply || true
EOD
  pre-deinstall: <<EOD
# Removed, not upgraded: give OPNsense its own files back.
[ -n "${PKG_UPGRADE}" ] || /usr/local/sbin/mono-core-patches revert || true
EOD
}
