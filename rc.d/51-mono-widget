#!/usr/local/bin/php
<?php

/*
 * Add the Mono Gateway widgets to every user's dashboard, once each. Users
 * who remove one afterwards keep it removed. "dry" only shows what would change.
 */

require_once('config.inc');

use OPNsense\Core\Config;

$dry = ($argv[1] ?? '') == 'dry';
$widgets_dir = '/usr/local/opnsense/www/js/widgets';

/* id => file, marker; each widget is added once, on its own marker */
$widgets = [
    'mono' => ['Mono.js', '/var/db/mono-widget-added'],
    'monoconnections' => ['MonoConnections.js', '/var/db/mono-connections-widget-added'],
    'monocpu' => ['MonoCpu.js', '/var/db/mono-cpu-widget-added'],
];

foreach ($widgets as $id => [$file, $marker]) {
    if ((file_exists($marker) && !$dry) || !file_exists("{$widgets_dir}/{$file}")) {
        unset($widgets[$id]);
    }
}

/* OPNsense 26.7 default dashboard, used for users who never saved one */
$default = [
    'options' => [],
    'widgets' => [
        ['id' => 'systeminformation', 'x' => 0, 'y' => 0, 'w' => 2],
        ['id' => 'memory', 'x' => 2, 'y' => 0],
        ['id' => 'disk', 'x' => 3, 'y' => 0],
        ['id' => 'interfacestatistics', 'x' => 4, 'y' => 0, 'w' => 4],
        ['id' => 'firewall', 'x' => 8, 'y' => 0, 'w' => 4],
        ['id' => 'gateways', 'x' => 2, 'y' => 1, 'w' => 2],
        ['id' => 'interfaces', 'x' => 4, 'y' => 1, 'w' => 4],
        ['id' => 'services', 'x' => 4, 'y' => 2, 'w' => '4'],
        ['id' => 'traffic', 'x' => 8, 'y' => 1, 'w' => 4],
        ['id' => 'cpu', 'x' => 0, 'y' => 1, 'w' => 2],
        ['id' => 'announcements', 'x' => 2, 'y' => 2, 'w' => 2],
    ]
];

/*
 * Put the connections gauge in the same row right after Disk (or Memory),
 * so the dashboard always packs the three gauges together. Widgets to its
 * right move over one column and, when the row is full, the last wide one
 * gives up a column. Without Memory or Disk it goes in the first free spot.
 */
function place_connections(array $list)
{
    $after = null;
    foreach (['memory', 'disk'] as $id) {
        foreach ($list as $w) {
            if ($w['id'] == $id && isset($w['x'], $w['y'])) {
                $after = $w;
            }
        }
    }
    if ($after === null) {
        $list[] = ['id' => 'monoconnections'];
        return $list;
    }

    $x = (int)$after['x'] + 1;
    $y = (int)$after['y'];
    $row = [];
    foreach ($list as $i => $w) {
        if (isset($w['x'], $w['y']) && (int)$w['y'] == $y && (int)$w['x'] >= $x) {
            $list[$i]['x'] = (int)$w['x'] + 1;
            $row[] = $i;
        }
    }

    $end = 0;
    foreach ($row as $i) {
        $end = max($end, (int)$list[$i]['x'] + (int)($list[$i]['w'] ?? 1));
    }
    if ($end > 12) {
        usort($row, fn($a, $b) => (int)$list[$b]['x'] - (int)$list[$a]['x']);
        foreach ($row as $i) {
            if ((int)($list[$i]['w'] ?? 1) > 2) {
                $list[$i]['w'] = (int)$list[$i]['w'] - 1;
                break;
            }
        }
    }

    $list[] = ['id' => 'monoconnections', 'x' => $x, 'y' => $y, 'w' => 1];
    return $list;
}

/*
 * Put the Mono Gateway widget right under System Information, as wide as it,
 * moving whatever sat below System Information down a row. Without System
 * Information it goes in the first free spot.
 */
function place_mono(array $list)
{
    $list = array_values(array_filter($list, fn($w) => $w['id'] != 'mono'));
    $info = null;
    foreach ($list as $w) {
        if ($w['id'] == 'systeminformation' && isset($w['x'], $w['y'])) {
            $info = $w;
        }
    }
    if ($info === null) {
        $list[] = ['id' => 'mono', 'w' => 2];
        return $list;
    }

    $left = (int)$info['x'];
    $right = $left + (int)($info['w'] ?? 1) - 1;
    $y = (int)$info['y'] + 1;
    foreach ($list as &$w) {
        if (!isset($w['x'], $w['y'])) {
            continue;
        }
        $wl = (int)$w['x'];
        $wr = $wl + (int)($w['w'] ?? 1) - 1;
        if ((int)$w['y'] >= $y && $wl <= $right && $wr >= $left) {
            $w['y'] = (int)$w['y'] + 1;
        }
    }
    unset($w);
    $list[] = ['id' => 'mono', 'x' => $left, 'y' => $y, 'w' => $right - $left + 1];
    return $list;
}

/*
 * Below 900 and 500 pixels the dashboard switches to 3 and 1 columns and,
 * without a saved layout for that width, scatters the widgets. Write one in
 * the wide layout's order. In 3 columns the gauges stack on the right next
 * to the first two widgets, then the rest go full width; in 1 column it is
 * the same order top to bottom.
 */
function narrow_layout(array $list, int $columns)
{
    $gauges = ['memory', 'disk', 'monoconnections'];
    usort($list, function ($a, $b) {
        $ka = isset($a['x'], $a['y']) ? [(int)$a['y'], (int)$a['x']] : [PHP_INT_MAX, 0];
        $kb = isset($b['x'], $b['y']) ? [(int)$b['y'], (int)$b['x']] : [PHP_INT_MAX, 0];
        return $ka <=> $kb;
    });
    // Mono Gateway stays right after System Information.
    $mono = array_values(array_filter($list, fn($w) => $w['id'] == 'mono'));
    if ($mono) {
        $list = array_values(array_filter($list, fn($w) => $w['id'] != 'mono'));
        $at = array_search('systeminformation', array_column($list, 'id'));
        array_splice($list, $at === false ? count($list) : $at + 1, 0, $mono);
    }
    $layout = [];
    if ($columns == 1) {
        foreach ($list as $i => $w) {
            $layout[$w['id']] = ['id' => $w['id'], 'x' => 0, 'y' => $i, 'w' => 1];
        }
        return $layout;
    }

    $row = 0;
    foreach ($list as $w) {
        if (in_array($w['id'], $gauges)) {
            $layout[$w['id']] = ['id' => $w['id'], 'x' => $columns - 1, 'y' => $row++, 'w' => 1];
        }
    }
    $left = 0;
    $next = max($row, 2);
    foreach ($list as $w) {
        if (in_array($w['id'], $gauges)) {
            continue;
        }
        if ($left < 2 && $row > 0) {
            $layout[$w['id']] = ['id' => $w['id'], 'x' => 0, 'y' => $left++, 'w' => $columns - 1];
        } else {
            $layout[$w['id']] = ['id' => $w['id'], 'x' => 0, 'y' => $next++, 'w' => $columns];
        }
    }
    return $layout;
}

/*
 * Add the gauge to a layout someone saved: right under Disk, as tall as
 * Disk, with everything below it in that column moved down to make room.
 */
function insert_below_disk(array $layout)
{
    if (!isset($layout['disk']['x'], $layout['disk']['y'])) {
        return $layout;
    }
    $disk = $layout['disk'];
    $x = (int)$disk['x'];
    $y = (int)$disk['y'] + (int)($disk['h'] ?? 1);
    $h = (int)($disk['h'] ?? 1);
    foreach ($layout as $id => $w) {
        $left = (int)($w['x'] ?? 0);
        $right = $left + (int)($w['w'] ?? 1) - 1;
        if ((int)($w['y'] ?? 0) >= $y && $left <= $x && $right >= $x) {
            $layout[$id]['y'] = (int)$w['y'] + $h;
        }
    }
    $layout['monoconnections'] = ['id' => 'monoconnections', 'x' => $x, 'y' => $y, 'w' => 1, 'h' => $h];
    return $layout;
}

/*
 * Swap the stock CPU widget for the Mono one in the same spot and size, in
 * the wide list and every saved layout. Without the stock one, nothing.
 */
function swap_cpu(array $dashboard)
{
    if (!in_array('cpu', array_column($dashboard['widgets'], 'id'))) {
        return null;
    }
    foreach ($dashboard['widgets'] as $i => $w) {
        if ($w['id'] == 'cpu') {
            $dashboard['widgets'][$i]['id'] = 'monocpu';
        }
    }
    foreach ($dashboard['layouts'] ?? [] as $columns => $layout) {
        if (isset($layout['cpu'])) {
            $layout['monocpu'] = array_merge($layout['cpu'], ['id' => 'monocpu']);
            unset($layout['cpu']);
            $dashboard['layouts'][$columns] = $layout;
        }
    }
    return $dashboard;
}

/* Put the gauge into the wide list and into a layout for every width. */
function add_connections(array $dashboard)
{
    $dashboard['widgets'] = place_connections($dashboard['widgets']);
    $layouts = $dashboard['layouts'] ?? [];
    foreach ([12, 3, 1] as $columns) {
        if (!empty($layouts[$columns])) {
            if ($columns == 12) {
                $layouts[12] = array_column(place_connections(array_values($layouts[12])), null, 'id');
            } else {
                $layouts[$columns] = insert_below_disk($layouts[$columns]);
            }
        } elseif ($columns != 12) {
            $layouts[$columns] = narrow_layout($dashboard['widgets'], $columns);
        }
    }
    $dashboard['layouts'] = $layouts;
    return $dashboard;
}

$mdl = new OPNsense\Auth\User();
$changed = false;

foreach ($mdl->user->iterateItems() as $node) {
    $name = (string)$node->name;
    $dashboard = $node->dashboard->deserialize();
    if (empty($dashboard['widgets'])) {
        $dashboard = $default;
    }
    $added = false;
    foreach (array_keys($widgets) as $id) {
        if (in_array($id, array_column($dashboard['widgets'], 'id'))) {
            echo "{$name}: already has {$id}\n";
            continue;
        }
        if ($id == 'monocpu') {
            $swapped = swap_cpu($dashboard);
            if ($swapped === null) {
                echo "{$name}: no stock cpu widget, not adding {$id}\n";
                continue;
            }
            $dashboard = $swapped;
        } elseif ($id == 'monoconnections') {
            $dashboard = add_connections($dashboard);
        } else {
            $dashboard['widgets'] = place_mono($dashboard['widgets']);
        }
        echo "{$name}: adding {$id}\n";
        $added = true;
    }
    /*
     * 26.7.7_6 added the Mono Gateway widget without a position. Until the
     * user saves the dashboard it still has none, and any narrow layouts are
     * the ones written here, so both can be redone with it next to System
     * Information.
     */
    foreach ($dashboard['widgets'] as $w) {
        if ($w['id'] == 'mono' && !isset($w['x'], $w['y'])) {
            $dashboard['widgets'] = place_mono($dashboard['widgets']);
            foreach ([3, 1] as $columns) {
                if (!empty($dashboard['layouts'][$columns])) {
                    $dashboard['layouts'][$columns] = narrow_layout($dashboard['widgets'], $columns);
                }
            }
            echo "{$name}: moving mono next to systeminformation\n";
            $added = true;
            break;
        }
    }
    if ($added && !$dry) {
        $node->dashboard->serialize($dashboard);
        $changed = true;
    }
}

if ($changed) {
    $mdl->serializeToConfig(false, true);
    Config::getInstance()->save();
}
if (!$dry) {
    foreach ($widgets as [$file, $marker]) {
        touch($marker);
    }
}
