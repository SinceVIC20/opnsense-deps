#!/bin/sh
#
# PROVIDE: cmm
# REQUIRE: NETWORKING pf dpa_app
# KEYWORD: shutdown
#
# cmm — Connection Management Module.
# Monitors PF conntrack state changes and offloads flows to CDX
# via FCI for hardware-accelerated forwarding.
#

. /etc/rc.subr

name="cmm"
rcvar="cmm_enable"
desc="Connection Management Module for CDX offload"

pidfile="/var/run/${name}.pid"
# rc.subr's own start and stop: stop waits for cmm to exit, start won't
# run a second copy. Two at once undo each other's CDX setup.
command="/usr/local/sbin/cmm"

start_precmd="cmm_prestart"
start_postcmd="cmm_poststart"

cmm_prestart()
{
	# Verify CDX module is loaded
	if ! kldstat -q -m cdx; then
		warn "cdx.ko not loaded — skipping cmm"
		return 1
	fi

	# Verify FCI module is loaded
	if ! kldstat -q -m fci; then
		warn "fci.ko not loaded — skipping cmm"
		return 1
	fi
}

# Optional limit on frames to the CPU, set in /etc/rc.conf.d/cmm (cmm_exptrate_pps,
# cmm_exptrate_burst); without it the default from dpa_app stays. cmmctl needs
# cmm's socket, so retry while cmm starts.
cmm_poststart()
{
	local i

	[ -n "${cmm_exptrate_pps}" ] || return 0
	i=0
	while [ $i -lt 10 ]; do
		/usr/local/sbin/cmmctl qm exptrate eth "${cmm_exptrate_pps}" \
		    "${cmm_exptrate_burst:-64}" > /dev/null 2>&1 && return 0
		sleep 1
		i=$((i + 1))
	done
	warn "could not set the CPU frame limit to ${cmm_exptrate_pps}"
}

load_rc_config $name

: ${cmm_enable:="NO"}
: ${cmm_flags:="-d 1"}

run_rc_command "$1"
