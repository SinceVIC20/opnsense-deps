Subject: [PATCH 12/24] interfaces: use pending assignment changes when a new
 address arrives during apply

Backport of upstream f329b00503, df1ef26b5c, 46d877d03a, 6fe1a0d9e7 and
5da3713526 (apply script refactor and unit test left out).
---
 src/etc/inc/interfaces.inc                    | 28 +++++++++++++++++++
 src/etc/rc.newwanip                           |  3 ++
 src/etc/rc.newwanipv6                         |  3 ++
 .../Interfaces/Api/AssignmentController.php   |  4 +++
 4 files changed, 38 insertions(+)

diff --git a/src/etc/inc/interfaces.inc b/src/etc/inc/interfaces.inc
index fd5be9e381..572667dd3f 100644
--- a/src/etc/inc/interfaces.inc
+++ b/src/etc/inc/interfaces.inc
@@ -4157,3 +4157,31 @@ function interfaces_primary_address6($interface, $ifconfig_details = null)
 
     return _interfaces_primary_address6($interface, $ifconfig_details, false, false);
 }
+
+/*
+ * This is specifically for rc.newwanip(v6) to merge configuration
+ * items when the controller is locking (processing) our working file.
+ */
+function interfaces_merge_pending()
+{
+    $filename = '/tmp/.interfaces.todo';
+
+    $fp = @fopen($filename, 're');
+    if ($fp === false) {
+        return;
+    }
+
+    $interfaces = &config_read_array('interfaces');
+
+    if (!flock($fp, LOCK_EX | LOCK_NB)) {
+        foreach (json_decode(fread($fp, filesize($filename)), true) ?? [] as $uuid => $work) {
+            if ($work['pending_action'] == 'delete') {
+                unset($interfaces[$uuid]);
+            } else {
+                $interfaces[$uuid] = $work['pending'];
+            }
+        }
+    }
+
+    fclose($fp);
+}
diff --git a/src/etc/rc.newwanip b/src/etc/rc.newwanip
index c4b5568970..8ab696b6b1 100755
--- a/src/etc/rc.newwanip
+++ b/src/etc/rc.newwanip
@@ -46,6 +46,9 @@ exit_on_bootup(function ($argument) {
     file_put_contents('/tmp/newwanip_' . $argument, $argument);
 }, [$argument]);
 
+/* merge pending changes when UI is processing */
+interfaces_merge_pending();
+
 if (empty($argument)) {
     $interface = 'wan';
     $device = get_real_interface($interface);
