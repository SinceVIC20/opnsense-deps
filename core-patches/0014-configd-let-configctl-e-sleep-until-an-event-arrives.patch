From 7432971190986d4ca34409b725deaa2195b017ed Mon Sep 17 00:00:00 2001
From: SinceVIC20 <codedesk@v3biolab.com>
Date: Tue, 27 Oct 2026 14:16:49 -0700
Subject: [PATCH 14/16] configd: let configctl -e sleep until an event arrives

In event mode configctl woke every -t seconds even with nothing to
send, twice a second for the config_changed listener syslog-ng keeps
running. Wait without a timeout until a line arrives, and use -t only
to gather the lines that follow it.
---
 src/opnsense/service/configd_ctl.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/opnsense/service/configd_ctl.py b/src/opnsense/service/configd_ctl.py
index c35ae74103..94b7ae11f9 100755
--- a/src/opnsense/service/configd_ctl.py
+++ b/src/opnsense/service/configd_ctl.py
@@ -120,7 +120,8 @@ if args.e:
     last_message_stamp = time.time()
     stashed_lines = list()
     while True:
-        rlist, _, _ = select([sys.stdin], [], [], args.t)
+        # with nothing waiting to be sent, sleep until the next line
+        rlist, _, _ = select([sys.stdin], [], [], args.t if stashed_lines else None)
         if rlist:
             last_message_stamp = time.time()
             r_line = sys.stdin.readline()
