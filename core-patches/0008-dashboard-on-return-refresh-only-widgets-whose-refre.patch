From db2d6e479be25762b73fb4464f48abeb2d3fddb6 Mon Sep 17 00:00:00 2001
From: SinceVIC20 <codedesk@v3biolab.com>
Date: Tue, 27 Oct 2026 10:57:37 -0700
Subject: [PATCH 08/16] dashboard: on return, refresh only widgets whose
 refresh fell due

Showing the dashboard again refreshed every widget, so Announcements
fetched the OPNsense forum's feed from the internet on every return to
the tab instead of once an hour. Refresh a widget on return only when
its interval passed while the page was hidden.
---
 src/opnsense/www/js/opnsense_widget_manager.js | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/opnsense/www/js/opnsense_widget_manager.js b/src/opnsense/www/js/opnsense_widget_manager.js
index 48823b2c38..902848f886 100644
--- a/src/opnsense/www/js/opnsense_widget_manager.js
+++ b/src/opnsense/www/js/opnsense_widget_manager.js
@@ -562,10 +562,12 @@ class WidgetManager  {
             }
         }
 
+        let lastTick = Date.now();
         await tick();
         const refresh = async () => {
             // a dashboard in a background tab doesn't need fresh data
             if (!document.hidden) {
+                lastTick = Date.now();
                 await tick();
             }
         };
@@ -579,9 +581,12 @@ class WidgetManager  {
             refresh();
         }, offset);
         this.widgetTickRoutines[widget.id] = routine;
-        // catch up as soon as the dashboard is shown again
+        // catch up when the dashboard is shown again, if a refresh fell due
+        // while it was hidden (some widgets fetch from the internet)
         document.addEventListener('visibilitychange', async () => {
-            if (!document.hidden && this.widgetTickRoutines[widget.id] === routine) {
+            if (!document.hidden && this.widgetTickRoutines[widget.id] === routine &&
+                Date.now() - lastTick >= widget.tickTimeout * 1000) {
+                lastTick = Date.now();
                 await tick();
             }
         });
