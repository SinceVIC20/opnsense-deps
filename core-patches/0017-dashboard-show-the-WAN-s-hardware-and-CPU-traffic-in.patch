From 55319b7fe0c92164b4468824b51e00ea84d019cc Mon Sep 17 00:00:00 2001
From: SinceVIC20 <codedesk@v3biolab.com>
Date: Sun, 1 Nov 2026 20:42:24 -0700
Subject: [PATCH 17/20] dashboard: show the WAN's hardware and CPU traffic in
 the traffic graph

Cnx HW and Cnx CPU split the WAN's traffic in and out into what the
hardware forwarded and what the CPU handled. They start at the front of
the row and can be moved and turned off like the other entries. They
only appear when the WAN reports offloaded traffic.
---
 .../scripts/interfaces/if_counters.py         | 43 +++++++++++++++++++
 .../scripts/interfaces/traffic_stats.php      | 17 ++++++++
 src/opnsense/www/js/widgets/Metadata/Core.xml |  2 +
 src/opnsense/www/js/widgets/Traffic.js        | 32 +++++++++++---
 4 files changed, 89 insertions(+), 5 deletions(-)

diff --git a/src/opnsense/scripts/interfaces/if_counters.py b/src/opnsense/scripts/interfaces/if_counters.py
index 1f0f5fb6cf..0a97701361 100755
--- a/src/opnsense/scripts/interfaces/if_counters.py
+++ b/src/opnsense/scripts/interfaces/if_counters.py
@@ -73,6 +73,48 @@ ifaddrs._fields_ = [
 libc = ctypes.CDLL('libc.so.7', use_errno=True)
 libc.getifaddrs.argtypes = [ctypes.POINTER(ctypes.POINTER(ifaddrs))]
 libc.freeifaddrs.argtypes = [ctypes.POINTER(ifaddrs)]
+libc.sysctlbyname.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_size_t),
+                              ctypes.c_void_p, ctypes.c_size_t]
+
+# the MAC counts each frame's checksum, the driver's own counts don't
+FCS_BYTES = 4
+
+
+def sysctl(name, size=8):
+    """A sysctl's raw value, None where there is no such sysctl."""
+    buf = ctypes.create_string_buffer(size)
+    length = ctypes.c_size_t(size)
+    if libc.sysctlbyname(name.encode(), buf, ctypes.byref(length), None, 0) != 0:
+        return None
+    return buf.raw[:length.value]
+
+
+def sysctl_u64(name):
+    raw = sysctl(name)
+    return int.from_bytes(raw, sys.byteorder) if raw is not None and len(raw) == 8 else None
+
+
+def offloaded(result):
+    """
+    Bytes the hardware forwarded in and out of each interface, where it is
+    known: on a Mono Gateway port, all it counted less what went through the
+    CPU; on a VLAN or PPPoE interface over one, what cdx counted for it.
+    """
+    for name, item in result.items():
+        if name.startswith('dtsec') and name[5:].isdigit():
+            base = 'dev.dtsec.%s.' % name[5:]
+            cpu = {key: sysctl_u64(base + key) for key in ('cpu_ibytes', 'cpu_obytes', 'cpu_ipackets', 'cpu_opackets')}
+            if None not in cpu.values():
+                item['offloaded bytes received'] = max(0, item['bytes received'] -
+                                                       cpu['cpu_ibytes'] - FCS_BYTES * cpu['cpu_ipackets'])
+                item['offloaded bytes transmitted'] = max(0, item['bytes transmitted'] -
+                                                          cpu['cpu_obytes'] - FCS_BYTES * cpu['cpu_opackets'])
+    raw = sysctl('dev.cdx.stats.offloaded_bytes', 8192)
+    for line in (raw or b'').rstrip(b'\0').decode(errors='replace').splitlines():
+        parts = line.split()
+        if len(parts) == 3 and parts[0] in result:
+            result[parts[0]]['offloaded bytes received'] = int(parts[1])
+            result[parts[0]]['offloaded bytes transmitted'] = int(parts[2])
 
 
 def counters():
@@ -98,6 +140,7 @@ def counters():
             ifa = item.ifa_next
     finally:
         libc.freeifaddrs(head)
+    offloaded(result)
     return result
 
 
diff --git a/src/opnsense/scripts/interfaces/traffic_stats.php b/src/opnsense/scripts/interfaces/traffic_stats.php
index a8b1e4a927..547469fb91 100755
--- a/src/opnsense/scripts/interfaces/traffic_stats.php
+++ b/src/opnsense/scripts/interfaces/traffic_stats.php
@@ -82,6 +82,23 @@ if (isset($argv[1])) {
         }
 
         $result = map_ifs($intfs, $tmp);
+
+        /* the WAN's traffic split into what the hardware forwarded and what the CPU handled */
+        $wan = $intfs['wan']['if'] ?? null;
+        if (
+            $wan !== null && isset($interfaces[$wan]['offloaded bytes received']) &&
+            isset($prev[$wan]['offloaded bytes received'])
+        ) {
+            $split = ['hw' => [], 'cpu' => []];
+            foreach (['inbytes' => 'received', 'outbytes' => 'transmitted'] as $field => $dir) {
+                $total = $tmp[$wan]["bytes {$dir}"];
+                /* a record handed back moves its counts into the interface: never more than all */
+                $hw = min(max(0, $interfaces[$wan]["offloaded bytes {$dir}"] - $prev[$wan]["offloaded bytes {$dir}"]), max(0, $total));
+                $split['hw'][$field] = $hw;
+                $split['cpu'][$field] = max(0, $total - $hw);
+            }
+            $result['offload'] = $split;
+        }
         $prev = $interfaces;
         echo 'event: message' . PHP_EOL;
         echo 'data: ' . json_encode($result) . PHP_EOL . PHP_EOL;
diff --git a/src/opnsense/www/js/widgets/Metadata/Core.xml b/src/opnsense/www/js/widgets/Metadata/Core.xml
index 4531653fae..acf567859f 100644
--- a/src/opnsense/www/js/widgets/Metadata/Core.xml
