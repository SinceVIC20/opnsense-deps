name: "mono-upgrade-safety"
version: "%%VERSION%%"
origin: "sysutils/mono-upgrade-safety"
comment: "Safe kernel updates and upgrades for the Mono Gateway"
desc: <<EOD
Tests a new kernel once and rolls back by itself when it fails, keeps a
history of upgrade attempts, holds back a release that failed on this
router and writes a short failure report.
EOD
maintainer: "codedesk@v3biolab.com"
www: "https://mono-opnsense.sincevic20.com"
abi: "FreeBSD:*"
arch: "freebsd:*"
prefix: "/"
categories: ["sysutils"]
licenses: ["BSD2CLAUSE"]
licenselogic: "single"
scripts: {
  post-install: <<EOD
if mount | grep -q ' on /boot/msdos '; then
	cp /usr/local/share/mono-upgrade/mono-boot.txt /boot/msdos/mono-boot.txt
fi
/usr/local/sbin/mono-upgrade decide || true
EOD
}
